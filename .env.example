# Copy to .env (repo root) and fill in. Never commit .env.
# The backend and alembic load this file on startup; shell variables take precedence.

# Database: either a full URL ...
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/careersync_db
# ... or the parts (DB_HOST=db inside docker compose, localhost when running the backend locally)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=careersync_db

JWT_SECRET_KEY=replace_with_a_secure_random_secret

# AI: AI_MODE=rules (default) or llm. Only llm calls the paid Claude API and then needs LLM_API_KEY;
# the backend refuses to start with AI_MODE=llm and no key. The key is ignored in rules mode.
AI_MODE=rules
LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# Use hashing-ngram-v1 to skip downloading the ~1GB e5 model during local testing.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
