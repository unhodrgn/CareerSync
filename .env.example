# Copy to .env (repo root) and fill in. Never commit .env.
# The backend and alembic load this file on startup; shell variables take precedence.
# An empty value counts as unset (the default is used), except AI_MODE (empty = rules) and LLM_API_KEY (empty = no key).

# Database: either a full URL ...
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/careersync_db
# ... or the parts. Docker Compose sets DB_HOST and DB_PORT itself and takes only DB_USER, DB_PASSWORD and DB_NAME from here
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=careersync_db

# Missing or empty secrets fall back to built-in dev values and the backend logs a warning at startup;
# set long random values for anything shared.
JWT_SECRET_KEY=replace_with_a_secure_random_secret
# Key for talent anonymous IDs (C-…); changing it changes every ID companies see
TALENT_ID_SECRET=replace_with_another_secure_random_secret

# AI: AI_MODE=rules (default) or llm. Only llm calls the paid Claude API and then needs LLM_API_KEY;
# the backend refuses to start with AI_MODE=llm and no key. The key is ignored in rules mode.
AI_MODE=rules
LLM_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# Use hashing-ngram-v1 to skip downloading the ~1GB e5 model during local testing.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
