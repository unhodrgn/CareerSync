# Copy to interview_poc/.env (git-ignored) and fill in the values. Never commit .env or put a key in source code.
# Only this folder's own .env is read; the CareerSync repo-root .env is never read by the PoC.
# An empty value counts as unset.

# LiveKit Cloud project (Settings > Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Anam (avatar). The id below is the stock avatar used as the example in Anam's API docs; any stock avatar id
# from the Anam Avatar Gallery works.
ANAM_API_KEY=
ANAM_AVATAR_ID=071b0286-4cce-4808-bee2-e642f1062de3

# LLM: Groq through LiveKit's Groq plugin (a standalone choice for this PoC). Key: https://console.groq.com/keys
# The LLM is only used when AI_MODE=llm (docs/DECISIONS.md D5, D12). Remove any old LLM_API_KEY line: it is no longer read.
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
AI_MODE=llm

# Optional
# POC_AVATAR=on                    # on | off. off = audio-only (check Korean STT, LLM and TTS before turning the avatar on)
# POC_TTS_VOICE=                   # Cartesia voice id for sonic-3 (default: a documented sample voice; pick a Korean voice)
# POC_LLM_REASONING_EFFORT=low     # low | medium | high. Default: low for openai/gpt-oss-* models; other models never get the field
# POC_MASK_NAMES=                  # comma-separated synthetic names to mask in spoken answers
